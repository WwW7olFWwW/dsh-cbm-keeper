{
  "name": "dsh-cbm-keeper",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH × Codebase Memory 圖譜保鮮插件：讓 CBM 知識圖譜自動跟上各專案的 git HEAD（落後偵測、條件式 CLI 重建、每專案監看、設定頁觀測卡片與 REST 控制面）。",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "optionalDependencies": {
    "chokidar": "^4.0.3"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:syntax": "for f in lib/*.js test/*.js test/helpers/*.js tools/*.mjs; do node --check \"$f\" || exit 1; done",
    "verify:keeper": "node tools/verify-keeper.mjs",
    "verify:client": "node tools/verify-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codebase-memory",
    "cbm",
    "knowledge-graph",
    "graph-freshness",
    "stale-index",
    "cordis"
  ],
  "author": "WwW7olFWwW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WwW7olFWwW/dsh-cbm-keeper.git"
  },
  "homepage": "https://github.com/WwW7olFWwW/dsh-cbm-keeper#readme",
  "bugs": {
    "url": "https://github.com/WwW7olFWwW/dsh-cbm-keeper/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
